// The first-person view, drawn over the whole screen inside the viewport render. Each pixel whose ray meets the floor
// inside the look's area shows that floor point. Through a hole it shows the levels below, or the stock picture of the
// level below, or the sky. Past that area, and above the horizon, it shows the sky where the view opens out and
// darkness where the floor runs on unloaded. With BACKDROP_ON the sky shows the flat view's background, laid round a
// centre direction. The meshes go on top.
light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D MESH_TEXTURE;
// The sky round the eye: the full turn across, straight down to straight up.
uniform sampler2D SKY_TEXTURE;
// Every tile in the stock picture.
uniform sampler2D MASK_TEXTURE;
// The flat view's background, in the stock picture's frame, when BACKDROP_ON is 1. It is laid round a centre
// direction by angle: a ray's turn away from the centre is its distance from the eye in the picture, and a quarter
// turn is BACKDROP_REACH tiles. E1 and E2 are two directions square to the centre, and U1 and U2 how far one tile
// along each moves in the picture. Directions are to the right, ahead and up of the eye.
uniform sampler2D BACKDROP_TEXTURE;
uniform highp float BACKDROP_ON;
uniform highp float BACKDROP_REACH;
uniform highp vec3 BACKDROP_CENTRE;
uniform highp vec3 BACKDROP_E1;
uniform highp vec3 BACKDROP_E2;
uniform highp vec2 BACKDROP_U1;
uniform highp vec2 BACKDROP_U2;
// The levels below, nearest first, LOWER_COUNT of them. A level's floor lies LOWER_DROP tiles under the player's. Its
// picture lines up with the stock picture and is clear where the level is open.
uniform sampler2D LOWER_TEX0;
uniform sampler2D LOWER_TEX1;
uniform sampler2D LOWER_TEX2;
uniform sampler2D LOWER_TEX3;
uniform sampler2D LOWER_TEX4;
uniform sampler2D LOWER_TEX5;
uniform sampler2D LOWER_TEX6;
uniform sampler2D LOWER_TEX7;
uniform highp float LOWER_COUNT;
// The first four levels' values, then the next four's.
uniform highp vec4 LOWER_DROP;
uniform highp vec4 LOWER_DROP2;
// Otherwise the stock picture of the level below, in BACKDROP_TEXTURE: STOCK_LOWER_DEPTH tiles down, moved by
// STOCK_LOWER_SHIFT and drawn STOCK_LOWER_SCALE times as large, as CE draws it.
uniform highp float STOCK_LOWER_ON;
uniform highp vec2 STOCK_LOWER_SHIFT;
uniform highp float STOCK_LOWER_SCALE;
uniform highp float STOCK_LOWER_DEPTH;
// Focal length in pixels.
uniform highp float FOCAL;
// Sine and cosine of the upward tilt.
uniform highp vec2 PITCH;
// Eye height in tiles.
uniform highp float EYE_HEIGHT;
// Where the eye stands in the stock picture, and how far one tile to its right and one ahead move there.
uniform highp vec2 EYE_UV;
uniform highp vec2 AXIS_R;
uniform highp vec2 AXIS_F;
// One tile of the stock picture, as a share of it.
uniform highp vec2 TILE_UV;
// The world directions to the right of the view and ahead of it.
uniform highp vec2 LOOK_RIGHT;
uniform highp vec2 LOOK_UP;
// Half the size of the area first person shows, in tiles across and ahead of the look: the flat view's rectangle
// turned with the look.
uniform highp vec2 LOOK_HALF;

// The weather's fog, the same in the floor, mesh and weather passes: it thickens with distance from the eye and drifts
// in patches fixed in the world, and stays out from under roofs.
uniform highp float FOG_ON;
uniform highp vec3 FOG_COLOR;
uniform highp float FOG_MAX;
uniform highp float FOG_THICK;
uniform highp float FOG_SCALE;
uniform highp vec2 FOG_CELL;
uniform highp vec2 FOG_LOOK_RIGHT;
uniform highp vec2 FOG_LOOK_UP;
uniform sampler2D FOG_MASK;
uniform highp vec2 FOG_MASK_EYE;
uniform highp vec2 FOG_MASK_SIZE;

highp float fogHash(highp vec2 p) {
    p = mod(p, 1024.0);
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

highp float fogNoise(highp vec2 x) {
    highp vec2 i = floor(x);
    highp vec2 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(fogHash(i), fogHash(i + vec2(1.0, 0.0)), f.x),
        mix(fogHash(i + vec2(0.0, 1.0)), fogHash(i + vec2(1.0, 1.0)), f.x), f.y);
}

// How much fog lies between the eye and a point on the ground, given from the eye in world tiles.
highp float fogAt(highp vec2 rel) {
    if (FOG_ON < 0.5)
        return 0.0;

    highp vec2 mid = rel * 0.5;
    highp vec2 maskUv = (FOG_MASK_EYE + mid) / FOG_MASK_SIZE;
    highp float roof = 0.0;
    if (maskUv.x >= 0.0 && maskUv.y >= 0.0 && maskUv.x <= 1.0 && maskUv.y <= 1.0)
        roof = texture2D(FOG_MASK, maskUv).r;

    // The patches are read at the point itself, so they hold still in the world as the eye moves.
    highp vec2 q = FOG_CELL + rel * FOG_SCALE;
    highp float patch = 0.6 * fogNoise(q) + 0.4 * fogNoise(q * 2.0 + vec2(17.3, 5.1));
    highp float thick = FOG_THICK * (0.4 + 1.2 * patch);
    return FOG_MAX * (1.0 - exp(-length(rel) * thick)) * clamp(1.0 - roof * 2.0, 0.0, 1.0);
}
// 1 on open ground, where the land runs on under the sky.
uniform highp float OPEN;
// Height of the ceiling over the player, in tiles. A ray past the picture that is above it by then passes over.
uniform highp float ROOF;
// Size of a drawn pixel in screen pixels, and 1 for the retro look: coarse pixels dithered down to 5 bits a channel.
uniform highp float PIXEL;
uniform highp float RETRO;

highp float bayer2(highp vec2 a) {
    a = floor(a);
    return fract(a.x / 2.0 + a.y * a.y * 0.75);
}

highp float bayer4(highp vec2 a) {
    return bayer2(a * 0.5) * 0.25 + bayer2(a);
}

// How many tiles a point of the stock picture lies inside its edge.
highp float inside(highp vec2 uv) {
    highp vec2 d = min(uv, 1.0 - uv) / TILE_UV;
    return min(d.x, d.y);
}

// What a ray going down meets on one level below, fogged by its distance and weighted by its cover, clear where
// the level is open. dx and dy are the steps of the player's floor point across one screen pixel.
highp vec4 lowerLevel(sampler2D tex, highp float drop, highp vec2 p, highp float ahead, highp float up,
    highp vec2 dx, highp vec2 dy, highp vec2 size) {
    highp float t = (EYE_HEIGHT + drop) / -up;
    highp vec2 uv = EYE_UV + AXIS_R * (p.x * t) + AXIS_F * (ahead * t);
    // It ends where the player's own floor does, fading over the last tile.
    highp float edge = min(min(LOOK_HALF.x - abs(p.x * t), LOOK_HALF.y - abs(ahead * t)), inside(uv));
    edge = clamp(edge, 0.0, 1.0);
    if (edge <= 0.0) {
        return vec4(0.0);
    }

    // A far pixel covers several pixels of the picture. Four taps across it keep it from flickering, as on the
    // player's own floor.
    highp float k = (EYE_HEIGHT + drop) / EYE_HEIGHT;
    highp vec2 sx = dx * k;
    highp vec2 sy = dy * k;
    highp vec4 c = texture2D(tex, uv);
    if (max(length(sx * size), length(sy * size)) > 1.0) {
        c = 0.25 * (texture2D(tex, uv + 0.25 * (sx + sy)) + texture2D(tex, uv - 0.25 * (sx + sy))
            + texture2D(tex, uv + 0.25 * (sx - sy)) + texture2D(tex, uv - 0.25 * (sx - sy)));
    }

    c.rgb = c.a > 0.001 ? c.rgb / c.a : c.rgb;
    c.rgb = mix(c.rgb, FOG_COLOR, fogAt(LOOK_RIGHT * (p.x * t) + LOOK_UP * (ahead * t)));
    highp float cover = smoothstep(0.0, 1.0, c.a) * edge;
    return vec4(c.rgb * cover, cover);
}

// Lays a level's colour, already weighted by its cover, under what the ray has met so far.
highp vec4 under(highp vec4 acc, highp vec4 c) {
    return (1.0 - acc.a) * c + acc;
}

// The sky along a ray, given to the right, ahead and up of the eye.
highp vec3 skyAlong(highp float right, highp float ahead, highp float up) {
    highp vec2 world = LOOK_RIGHT * right + LOOK_UP * ahead;
    highp float yaw = atan(world.y, world.x);
    highp float tilt = atan(up, length(world));
    highp vec2 uv = vec2(fract(yaw / 6.2831853 + 0.5), 0.5 + tilt / 3.1415927);
    return texture2D(SKY_TEXTURE, uv).rgb;
}

// What lies past the stock picture along a ray, given across, ahead and up: darkness where the ray leaves the picture
// over floor and below its roofs, so the station runs on unloaded, and the sky where it is open or passes over.
highp vec3 beyond(highp vec2 dir, highp float up, highp vec3 sky) {
    if (OPEN > 0.5) {
        return sky;
    }

    highp vec2 at = EYE_UV;
    highp float len = length(dir);
    if (len > 0.0001) {
        highp vec2 n = dir / len;
        highp vec2 along = AXIS_R * n.x + AXIS_F * n.y;
        highp float tx = abs(n.x) > 0.0001 ? LOOK_HALF.x / abs(n.x) : 1000000.0;
        highp float ty = abs(n.y) > 0.0001 ? LOOK_HALF.y / abs(n.y) : 1000000.0;
        highp float t = max(min(tx, ty) - 0.5, 0.0);
        if (EYE_HEIGHT + up / len * t > ROOF) {
            return sky;
        }

        at = EYE_UV + along * t;
    }

    return texture2D(MASK_TEXTURE, at).r > 0.5 ? vec3(0.0) : sky;
}

void fragment() {
    highp vec2 size = 1.0 / SCREEN_PIXEL_SIZE;
    highp vec2 cell = floor(FRAGCOORD.xy / PIXEL);
    highp vec2 uv = (cell + 0.5) * PIXEL * SCREEN_PIXEL_SIZE;
    // Centred pixels over the focal length, with y up, then the ray through them: across, ahead and up.
    highp vec2 p = (uv - 0.5) * size / FOCAL;
    highp float ahead = PITCH.y - p.y * PITCH.x;
    highp float up = PITCH.x + p.y * PITCH.y;

    // Where the ray meets the floor, worked out on every pixel so its rate of change across pixels is known.
    highp float t = EYE_HEIGHT / max(-up, 0.0001);
    highp vec2 flatUv = EYE_UV + AXIS_R * (p.x * t) + AXIS_F * (ahead * t);
    highp vec2 dx = dFdx(flatUv);
    highp vec2 dy = dFdy(flatUv);

    highp vec3 sky = skyAlong(p.x, ahead, up);
    if (BACKDROP_ON > 0.5) {
        // The ray's turn away from the centre sets how far out in the picture it looks. It fades into the sky over
        // the last two tiles of the picture.
        highp vec3 ray = normalize(vec3(p.x, ahead, up));
        highp float along = dot(ray, BACKDROP_CENTRE);
        highp vec3 side = ray - BACKDROP_CENTRE * along;
        highp float sideLen = length(side);
        highp float turn = acos(clamp(along, -1.0, 1.0));
        if (turn < 1.7) {
            highp vec2 toward = sideLen > 0.00001 ? vec2(dot(side, BACKDROP_E1), dot(side, BACKDROP_E2)) / sideLen
                : vec2(0.0);
            highp float dist = turn / 1.5707963 * BACKDROP_REACH;
            highp vec2 backUv = EYE_UV + (BACKDROP_U1 * toward.x + BACKDROP_U2 * toward.y) * dist;
            highp float fade = clamp(inside(backUv) * 0.5, 0.0, 1.0);
            if (fade > 0.0) {
                sky = mix(sky, texture2D(BACKDROP_TEXTURE, backUv).rgb, fade);
            }
        }
    }

    highp vec3 color = beyond(vec2(p.x, ahead), up, sky);
    // Past the floor the fog is as thick as at the edge of the view area, so the sky meets the ground in it.
    highp vec2 flatDir = vec2(p.x, ahead);
    highp float flatLen = length(flatDir);
    if (FOG_ON > 0.5 && flatLen > 0.0001) {
        highp vec2 n = flatDir / flatLen;
        highp float reach = min(abs(n.x) > 0.0001 ? LOOK_HALF.x / abs(n.x) : 1000000.0,
            abs(n.y) > 0.0001 ? LOOK_HALF.y / abs(n.y) : 1000000.0);
        color = mix(color, FOG_COLOR, fogAt((LOOK_RIGHT * n.x + LOOK_UP * n.y) * reach));
    }

    if (up < -0.0001) {
        highp float edge = min(min(LOOK_HALF.x - abs(p.x * t), LOOK_HALF.y - abs(ahead * t)), inside(flatUv));
        bool hole = inside(flatUv) <= 0.0 || texture2D(MASK_TEXTURE, flatUv).r < 0.5;
        if (hole && LOWER_COUNT > 0.5) {
            // Through a hole the ray goes on down, meeting each level below at its own depth.
            highp vec4 below = lowerLevel(LOWER_TEX0, LOWER_DROP.x, p, ahead, up, dx, dy, size);
            if (LOWER_COUNT > 1.5 && below.a < 0.99) {
                below = under(below, lowerLevel(LOWER_TEX1, LOWER_DROP.y, p, ahead, up, dx, dy, size));
            }

            if (LOWER_COUNT > 2.5 && below.a < 0.99) {
                below = under(below, lowerLevel(LOWER_TEX2, LOWER_DROP.z, p, ahead, up, dx, dy, size));
            }

            if (LOWER_COUNT > 3.5 && below.a < 0.99) {
                below = under(below, lowerLevel(LOWER_TEX3, LOWER_DROP.w, p, ahead, up, dx, dy, size));
            }

            if (LOWER_COUNT > 4.5 && below.a < 0.99) {
                below = under(below, lowerLevel(LOWER_TEX4, LOWER_DROP2.x, p, ahead, up, dx, dy, size));
            }

            if (LOWER_COUNT > 5.5 && below.a < 0.99) {
                below = under(below, lowerLevel(LOWER_TEX5, LOWER_DROP2.y, p, ahead, up, dx, dy, size));
            }

            if (LOWER_COUNT > 6.5 && below.a < 0.99) {
                below = under(below, lowerLevel(LOWER_TEX6, LOWER_DROP2.z, p, ahead, up, dx, dy, size));
            }

            if (LOWER_COUNT > 7.5 && below.a < 0.99) {
                below = under(below, lowerLevel(LOWER_TEX7, LOWER_DROP2.w, p, ahead, up, dx, dy, size));
            }

            color = below.rgb + color * (1.0 - below.a);
        } else if (edge > 0.0) {
            highp vec3 ground = sky;
            if (hole && STOCK_LOWER_ON > 0.5) {
                // Through a hole the ray goes on down to the level below's floor.
                highp float tl = (EYE_HEIGHT + STOCK_LOWER_DEPTH) / -up;
                highp vec2 at = EYE_UV + AXIS_R * (p.x * tl) + AXIS_F * (ahead * tl) - STOCK_LOWER_SHIFT;
                highp vec2 lowerUv = 0.5 + (at - 0.5) / STOCK_LOWER_SCALE;
                highp float lowerEdge = clamp(inside(lowerUv) * 0.5, 0.0, 1.0);
                ground = mix(vec3(0.0), texture2D(BACKDROP_TEXTURE, lowerUv).rgb, lowerEdge);
            } else if (!hole) {
                // A far pixel covers several pixels of the picture. Four taps across it keep it from flickering.
                highp float spread = max(length(dx * size), length(dy * size));
                if (spread > 1.0) {
                    ground = 0.25 * (texture2D(SCREEN_TEXTURE, flatUv + 0.25 * (dx + dy)).rgb
                        + texture2D(SCREEN_TEXTURE, flatUv - 0.25 * (dx + dy)).rgb
                        + texture2D(SCREEN_TEXTURE, flatUv + 0.25 * (dx - dy)).rgb
                        + texture2D(SCREEN_TEXTURE, flatUv - 0.25 * (dx - dy)).rgb);
                } else {
                    ground = texture2D(SCREEN_TEXTURE, flatUv).rgb;
                }
            }

            ground = mix(ground, FOG_COLOR, fogAt(LOOK_RIGHT * (p.x * t) + LOOK_UP * (ahead * t)));
            color = mix(color, ground, clamp(edge, 0.0, 1.0));
        }
    }

    highp vec4 mesh = texture2D(MESH_TEXTURE, uv);
    color = mesh.rgb + color * (1.0 - mesh.a);
    if (RETRO > 0.5) {
        color = floor(color * 31.0 + bayer4(cell)) / 31.0;
    }

    COLOR = vec4(color, 1.0);
}
